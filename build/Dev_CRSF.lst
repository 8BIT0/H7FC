 162:Device/Dev_CRSF.c **** /* serial receiver receive callback */
 163:Device/Dev_CRSF.c **** static uint8_t DevCRSF_Decode(DevCRSFObj_TypeDef *obj)
 164:Device/Dev_CRSF.c **** {
 165:Device/Dev_CRSF.c ****     volatile uint8_t comput_crc = 0;
 166:Device/Dev_CRSF.c ****     volatile uint8_t frame_crc = 0;
 167:Device/Dev_CRSF.c **** 
 168:Device/Dev_CRSF.c ****     if ((obj == NULL) || (obj->rec_cnt == 0) || (obj->frame.length <= 3))
 169:Device/Dev_CRSF.c ****         return CRSF_DECODE_ERROR;
