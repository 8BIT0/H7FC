   3:Device/Dev_CRSF.c **** /*
   4:Device/Dev_CRSF.c ****  * CRSF protocol
   5:Device/Dev_CRSF.c ****  *
   6:Device/Dev_CRSF.c ****  * CRSF protocol uses a single wire half duplex uart connection.
   7:Device/Dev_CRSF.c ****  * The master sends one frame every 4ms and the slave replies between two frames from the master.
   8:Device/Dev_CRSF.c ****  *
   9:Device/Dev_CRSF.c ****  * 420000 baud
  10:Device/Dev_CRSF.c ****  * not inverted
  11:Device/Dev_CRSF.c ****  * 8 Bit
  12:Device/Dev_CRSF.c ****  * 1 Stop bit
  13:Device/Dev_CRSF.c ****  * Big endian
  14:Device/Dev_CRSF.c ****  * 420000 bit/s = 46667 byte/s (including stop bit) = 21.43us per byte
  15:Device/Dev_CRSF.c ****  * Max frame size is 64 bytes
  16:Device/Dev_CRSF.c ****  * A 64 byte frame plus 1 sync byte can be transmitted in 1393 microseconds.
  17:Device/Dev_CRSF.c ****  *
  18:Device/Dev_CRSF.c ****  * CRSF_TIME_NEEDED_PER_FRAME_US is set conservatively at 1500 microseconds
  19:Device/Dev_CRSF.c ****  *
  20:Device/Dev_CRSF.c ****  * Every frame has the structure:
  21:Device/Dev_CRSF.c ****  * <Device address><Frame length><Type><Payload><CRC>
  22:Device/Dev_CRSF.c ****  *
  23:Device/Dev_CRSF.c ****  * Device address: (uint8_t)
  24:Device/Dev_CRSF.c ****  * Frame length:   length in  bytes including Type (uint8_t)
  25:Device/Dev_CRSF.c ****  * Type:           (uint8_t)
  26:Device/Dev_CRSF.c ****  * Payload:        (uint8_t)
  27:Device/Dev_CRSF.c ****  * CRC:            (uint8_t)
  28:Device/Dev_CRSF.c ****  *
  29:Device/Dev_CRSF.c ****  */
  30:Device/Dev_CRSF.c **** 
  31:Device/Dev_CRSF.c **** #define Debug_Pin_En 0
