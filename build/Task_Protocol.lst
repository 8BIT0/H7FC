 215:Task/Task_Protocol.c **** void TaskFrameCTL_Core(void const *arg)
 216:Task/Task_Protocol.c **** {
 217:Task/Task_Protocol.c ****     uint32_t per_time = SrvOsCommon.get_os_ms();
 218:Task/Task_Protocol.c ****     bool cli_state = false;
 219:Task/Task_Protocol.c **** 
 220:Task/Task_Protocol.c ****     while(1)
 221:Task/Task_Protocol.c ****     {
 222:Task/Task_Protocol.c ****         TaskFrameCTL_ConfigureStateCheck();
 223:Task/Task_Protocol.c ****         SrvDataHub.get_cli_state(&cli_state);
 224:Task/Task_Protocol.c **** 
 225:Task/Task_Protocol.c ****         if (!Upgrade_Monitor.is_enable)
 226:Task/Task_Protocol.c ****         {
 227:Task/Task_Protocol.c ****             if (!cli_state)
 228:Task/Task_Protocol.c ****             {
 229:Task/Task_Protocol.c ****                 /* frame protocol process */
 230:Task/Task_Protocol.c ****                 TaskFrameCTL_PortFrameOut_Process();
 231:Task/Task_Protocol.c ****             }
 232:Task/Task_Protocol.c ****             else
 233:Task/Task_Protocol.c ****                 /* command line process */
 234:Task/Task_Protocol.c ****                 TaskFrameCTL_CLI_Proc();
 235:Task/Task_Protocol.c ****         }
 236:Task/Task_Protocol.c ****         else
 237:Task/Task_Protocol.c ****             /* upgrade process */
 238:Task/Task_Protocol.c ****             TaskFrameCTL_Upgrade_StatePolling(cli_state);
 239:Task/Task_Protocol.c **** 
 240:Task/Task_Protocol.c ****         SrvOsCommon.precise_delay(&per_time, FrameCTL_Period);
 241:Task/Task_Protocol.c ****     }
 242:Task/Task_Protocol.c **** }
