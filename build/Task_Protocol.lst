 654:Task/Task_Protocol.c ****         }
 655:Task/Task_Protocol.c **** 
 656:Task/Task_Protocol.c ****         /* suspend Telemetry task */
 657:Task/Task_Protocol.c ****         /* when upgrade finish or abort resume telemtry task */
 658:Task/Task_Protocol.c **** 
 659:Task/Task_Protocol.c ****         return true;
 660:Task/Task_Protocol.c ****     }
 661:Task/Task_Protocol.c **** 
 662:Task/Task_Protocol.c ****     return false;
