 245:Task/Task_Protocol.c **** /************************************** radio section ********************************************/
 246:Task/Task_Protocol.c **** static void TaskFrameCTL_DefaultPort_Init(FrameCTL_PortMonitor_TypeDef *monitor)
 247:Task/Task_Protocol.c **** {
 248:Task/Task_Protocol.c ****     if(monitor)
 249:Task/Task_Protocol.c ****     {
 250:Task/Task_Protocol.c ****         if(BspUSB_VCP.init((uint32_t)&(monitor->VCP_Port.RecObj)) != BspUSB_Error_None)
 251:Task/Task_Protocol.c ****         {
 252:Task/Task_Protocol.c ****             /* init default port VCP first */
 253:Task/Task_Protocol.c ****             monitor->VCP_Port.init_state = false;
 254:Task/Task_Protocol.c ****             return;
 255:Task/Task_Protocol.c ****         }
 256:Task/Task_Protocol.c ****         else
 257:Task/Task_Protocol.c ****             monitor->VCP_Port.init_state = true;
 258:Task/Task_Protocol.c **** 
 259:Task/Task_Protocol.c ****         /* create USB VCP Tx semaphore */
ARM GAS  C:\Users\HUAV\AppData\Local\Temp\ccteu8oL.s 			page 6


 260:Task/Task_Protocol.c ****         osSemaphoreDef(DefaultPort_Tx);
 261:Task/Task_Protocol.c ****         monitor->VCP_Port.p_tx_semphr = osSemaphoreCreate(osSemaphore(DefaultPort_Tx), 1);
 262:Task/Task_Protocol.c **** 
 263:Task/Task_Protocol.c ****         if(monitor->VCP_Port.p_tx_semphr == NULL)
 264:Task/Task_Protocol.c ****         {
 265:Task/Task_Protocol.c ****             monitor->VCP_Port.init_state = false;
 266:Task/Task_Protocol.c ****             return;
 267:Task/Task_Protocol.c ****         }
 268:Task/Task_Protocol.c **** 
 269:Task/Task_Protocol.c ****         BspUSB_VCP.set_tx_cpl_callback(TaskFrameCTL_Port_TxCplt_Callback);
 270:Task/Task_Protocol.c ****         BspUSB_VCP.set_rx_callback(TaskFrameCTL_Port_Rx_Callback);
 271:Task/Task_Protocol.c ****         BspUSB_VCP.set_connect_callback(TaskFrameCTL_USB_VCP_Connect_Callback);
 272:Task/Task_Protocol.c **** 
 273:Task/Task_Protocol.c ****         monitor->VCP_Port.RecObj.PortObj_addr = (uint32_t)&(monitor->VCP_Port);
 274:Task/Task_Protocol.c ****         monitor->VCP_Port.RecObj.type = Port_USB;
 275:Task/Task_Protocol.c **** 
 276:Task/Task_Protocol.c ****         USB_VCP_Addr = (uint32_t)&(monitor->VCP_Port);
 277:Task/Task_Protocol.c ****     }
 278:Task/Task_Protocol.c **** }
 279:Task/Task_Protocol.c **** 
 280:Task/Task_Protocol.c **** static bool TaskFrameCTL_DefaultPort_Trans(uint8_t *p_data, uint16_t size)
 281:Task/Task_Protocol.c **** {
 282:Task/Task_Protocol.c ****     bool state = false;
 283:Task/Task_Protocol.c **** 
 284:Task/Task_Protocol.c ****     /* when attach to host device then send data */
 285:Task/Task_Protocol.c ****     if (PortMonitor.VCP_Port.init_state && \
 286:Task/Task_Protocol.c ****         PortMonitor.vcp_connect_state && \
 287:Task/Task_Protocol.c ****         PortMonitor.VCP_Port.p_tx_semphr && \
 288:Task/Task_Protocol.c ****         p_data && size)
 289:Task/Task_Protocol.c ****     {
 290:Task/Task_Protocol.c ****         state = true;
 291:Task/Task_Protocol.c ****         osSemaphoreWait(PortMonitor.VCP_Port.p_tx_semphr, 0);
 292:Task/Task_Protocol.c ****         if ((BspUSB_VCP.send(p_data, size) != BspUSB_Error_None) || \
 293:Task/Task_Protocol.c ****             (osSemaphoreWait(PortMonitor.VCP_Port.p_tx_semphr, FrameCTL_Port_Tx_TimeOut) != osOK))
 294:Task/Task_Protocol.c ****             state = false;
 295:Task/Task_Protocol.c ****     }
 296:Task/Task_Protocol.c **** 
 297:Task/Task_Protocol.c ****     return state;
 298:Task/Task_Protocol.c **** }
