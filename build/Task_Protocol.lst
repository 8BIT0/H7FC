 634:Task/Task_Protocol.c **** static bool TaskFrameCTL_Upgrade_Enable(bool state, uint32_t port_addr, uint8_t port_type)
 635:Task/Task_Protocol.c **** {
 636:Task/Task_Protocol.c ****     bool arm_state = DRONE_ARM;
 637:Task/Task_Protocol.c **** 
