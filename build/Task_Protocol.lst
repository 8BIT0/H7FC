 634:Task/Task_Protocol.c **** static bool TaskFrameCTL_Upgrade_Enable(bool state, uint32_t port_addr, uint8_t port_type)
 635:Task/Task_Protocol.c **** {
 636:Task/Task_Protocol.c ****     bool arm_state = DRONE_ARM;
 637:Task/Task_Protocol.c **** 
 638:Task/Task_Protocol.c ****     /* check arm state first */
 639:Task/Task_Protocol.c ****     /* if is under disarm state then disable upgrade enabling */
 640:Task/Task_Protocol.c ****     if (SrvDataHub.get_arm_state(&arm_state) && (arm_state == DRONE_ARM))
 641:Task/Task_Protocol.c ****     {
