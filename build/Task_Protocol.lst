 643:Task/Task_Protocol.c ****         Upgrade_Monitor.port_addr = port_addr;
 644:Task/Task_Protocol.c ****         Upgrade_Monitor.port_type = port_type;
 645:Task/Task_Protocol.c ****         
 646:Task/Task_Protocol.c ****         if (!state)
 647:Task/Task_Protocol.c ****         {
 648:Task/Task_Protocol.c ****             Upgrade_Monitor.port_addr = 0;
