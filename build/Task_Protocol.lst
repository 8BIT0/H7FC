 176:Task/Task_Protocol.c **** void TaskFrameCTL_Init(uint32_t period)
 177:Task/Task_Protocol.c **** {
 178:Task/Task_Protocol.c ****     FrameCTL_Period = FrameCTL_MAX_Period;
 179:Task/Task_Protocol.c **** 
 180:Task/Task_Protocol.c ****     /* USB VCP as defaut port to tune parameter and frame porotcol */
