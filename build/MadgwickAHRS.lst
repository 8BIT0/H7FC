  45:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
  46:Algorithm/Navi_Dep/MadgwickAHRS.c **** void MadgwickAHRSInit(AlgoAttData_TypeDef *att)
  47:Algorithm/Navi_Dep/MadgwickAHRS.c **** {
  48:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	att->beta = betaDef;
  49:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	att->q0 = 1.0f;
  50:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	att->q1 = 0.0f;
  51:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	att->q2 = 0.0f;
  52:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	att->q3 = 0.0f;
  53:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	att->pitch = 0.0f;
  54:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	att->roll = 0.0f;
  55:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	att->yaw = 0.0f;
  56:Algorithm/Navi_Dep/MadgwickAHRS.c **** }
  57:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
  58:Algorithm/Navi_Dep/MadgwickAHRS.c **** void MadgwickAHRSupdate(AlgoAttData_TypeDef *att, float gx, float gy, float gz, float ax, float ay,
  59:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	float recipNorm;
  60:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	float s0, s1, s2, s3;
  61:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	float qDot1, qDot2, qDot3, qDot4;
  62:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	float hx, hy;
  63:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	float _2q0mx, _2q0my, _2q0mz, _2q1mx, _2bx, _2bz, _4bx, _4bz, _2q0, _2q1, _2q2, _2q3, _2q0q2, _2q2
  64:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
  65:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	if (att == NULL)
  66:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		return;
  67:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
  68:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	// Use IMU algorithm if magnetometer measurement invalid (avoids NaN in magnetometer normalisation
  69:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	if((mx == 0.0f) && (my == 0.0f) && (mz == 0.0f)) {
  70:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		MadgwickAHRSupdateIMU(att, gx, gy, gz, ax, ay, az);
  71:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		return;
  72:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	}
  73:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
  74:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	// Rate of change of quaternion from gyroscope
  75:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	qDot1 = 0.5f * (-att->q1 * gx - att->q2 * gy - att->q3 * gz);
  76:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	qDot2 = 0.5f * (att->q0 * gx + att->q2 * gz - att->q3 * gy);
  77:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	qDot3 = 0.5f * (att->q0 * gy - att->q1 * gz + att->q3 * gx);
  78:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	qDot4 = 0.5f * (att->q0 * gz + att->q1 * gy - att->q2 * gx);
  79:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
  80:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	// Compute feedback only if accelerometer measurement valid (avoids NaN in accelerometer normalisa
  81:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	if(!((ax == 0.0f) && (ay == 0.0f) && (az == 0.0f))) {
  82:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
  83:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		// Normalise accelerometer measurement
  84:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		recipNorm = invSqrt(ax * ax + ay * ay + az * az);
  85:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		ax *= recipNorm;
  86:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		ay *= recipNorm;
  87:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		az *= recipNorm;   
  88:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
ARM GAS  C:\Users\HUAV\AppData\Local\Temp\ccEcIbif.s 			page 3


  89:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		// Normalise magnetometer measurement
  90:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		recipNorm = invSqrt(mx * mx + my * my + mz * mz);
  91:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		mx *= recipNorm;
  92:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		my *= recipNorm;
  93:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		mz *= recipNorm;
  94:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
  95:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		// Auxiliary variables to avoid repeated arithmetic
  96:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2q0mx = 2.0f * att->q0 * mx;
  97:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2q0my = 2.0f * att->q0 * my;
  98:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2q0mz = 2.0f * att->q0 * mz;
  99:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2q1mx = 2.0f * att->q1 * mx;
 100:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2q0 = 2.0f * att->q0;
 101:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2q1 = 2.0f * att->q1;
 102:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2q2 = 2.0f * att->q2;
 103:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2q3 = 2.0f * att->q3;
 104:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2q0q2 = 2.0f * att->q0 * att->q2;
 105:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2q2q3 = 2.0f * att->q2 * att->q3;
 106:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		q0q0 = att->q0 * att->q0;
 107:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		q0q1 = att->q0 * att->q1;
 108:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		q0q2 = att->q0 * att->q2;
 109:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		q0q3 = att->q0 * att->q3;
 110:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		q1q1 = att->q1 * att->q1;
 111:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		q1q2 = att->q1 * att->q2;
 112:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		q1q3 = att->q1 * att->q3;
 113:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		q2q2 = att->q2 * att->q2;
 114:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		q2q3 = att->q2 * att->q3;
 115:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		q3q3 = att->q3 * att->q3;
 116:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
 117:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		// Reference direction of Earth's magnetic field
 118:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		hx = mx * q0q0 - _2q0my * att->q3 + _2q0mz * att->q2 + mx * q1q1 + _2q1 * my * att->q2 + _2q1 * m
 119:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		hy = _2q0mx * att->q3 + my * q0q0 - _2q0mz * att->q1 + _2q1mx * att->q2 - my * q1q1 + my * q2q2 +
 120:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2bx = sqrt(hx * hx + hy * hy);
 121:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_2bz = -_2q0mx * att->q2 + _2q0my * att->q1 + mz * q0q0 + _2q1mx * att->q3 - mz * q1q1 + _2q2 * m
 122:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_4bx = 2.0f * _2bx;
 123:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		_4bz = 2.0f * _2bz;
 124:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
 125:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		// Gradient decent algorithm corrective step
 126:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		s0 = -_2q2 * (2.0f * q1q3 - _2q0q2 - ax) + _2q1 * (2.0f * q0q1 + _2q2q3 - ay) - _2bz * att->q2 * 
 127:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		s1 = _2q3 * (2.0f * q1q3 - _2q0q2 - ax) + _2q0 * (2.0f * q0q1 + _2q2q3 - ay) - 4.0f * att->q1 * (
 128:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		s2 = -_2q0 * (2.0f * q1q3 - _2q0q2 - ax) + _2q3 * (2.0f * q0q1 + _2q2q3 - ay) - 4.0f * att->q2 * 
 129:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		s3 = _2q1 * (2.0f * q1q3 - _2q0q2 - ax) + _2q2 * (2.0f * q0q1 + _2q2q3 - ay) + (-_4bx * att->q3 +
 130:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		recipNorm = invSqrt(s0 * s0 + s1 * s1 + s2 * s2 + s3 * s3); // normalise step magnitude
 131:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		s0 *= recipNorm;
 132:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		s1 *= recipNorm;
 133:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		s2 *= recipNorm;
 134:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		s3 *= recipNorm;
 135:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
 136:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		// Apply feedback step
 137:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		qDot1 -= att->beta * s0;
 138:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		qDot2 -= att->beta * s1;
 139:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		qDot3 -= att->beta * s2;
 140:Algorithm/Navi_Dep/MadgwickAHRS.c **** 		qDot4 -= att->beta * s3;
 141:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	}
 142:Algorithm/Navi_Dep/MadgwickAHRS.c **** 
 143:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	// Integrate rate of change of quaternion to yield quaternion
 144:Algorithm/Navi_Dep/MadgwickAHRS.c **** 	att->q0 += qDot1 * (1.0f / sampleFreq);
