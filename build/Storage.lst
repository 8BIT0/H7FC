1576:System/storage/Storage.c **** static bool Storage_Compare_ItemSlot_CRC(const Storage_Item_TypeDef item)
1577:System/storage/Storage.c **** {
1578:System/storage/Storage.c ****     uint8_t *crc_buf = (uint8_t *)&item;
1579:System/storage/Storage.c ****     uint16_t crc_len = sizeof(Storage_Item_TypeDef);
1580:System/storage/Storage.c ****     uint16_t crc = 0;
1581:System/storage/Storage.c ****     
1582:System/storage/Storage.c ****     crc_buf += sizeof(item.head_tag);
1583:System/storage/Storage.c ****     crc_len -= sizeof(item.head_tag);
1584:System/storage/Storage.c ****     crc_len -= sizeof(item.end_tag);
1585:System/storage/Storage.c ****     crc_len -= sizeof(item.crc16);
1586:System/storage/Storage.c ****     crc = Common_CRC16(crc_buf, crc_len);
1587:System/storage/Storage.c **** 
1588:System/storage/Storage.c ****     if (crc == item.crc16)
1589:System/storage/Storage.c ****         return true;
1590:System/storage/Storage.c **** 
1591:System/storage/Storage.c ****     return false;
1592:System/storage/Storage.c **** }
1593:System/storage/Storage.c **** 
1594:System/storage/Storage.c **** static bool Storage_Comput_ItemSlot_CRC(Storage_Item_TypeDef *p_item)
1595:System/storage/Storage.c **** {
1596:System/storage/Storage.c ****     uint8_t *crc_buf = NULL;
1597:System/storage/Storage.c ****     uint16_t crc_len = sizeof(Storage_Item_TypeDef);
1598:System/storage/Storage.c ****     
1599:System/storage/Storage.c ****     if (p_item == NULL)
1600:System/storage/Storage.c ****         return false;
1601:System/storage/Storage.c **** 
1602:System/storage/Storage.c ****     crc_buf = ((uint8_t *)p_item) + sizeof(p_item->head_tag);
1603:System/storage/Storage.c ****     crc_len -= sizeof(p_item->head_tag);
1604:System/storage/Storage.c ****     crc_len -= sizeof(p_item->end_tag);
1605:System/storage/Storage.c ****     crc_len -= sizeof(p_item->crc16);
1606:System/storage/Storage.c ****     p_item->crc16 = Common_CRC16(crc_buf, crc_len);
1607:System/storage/Storage.c **** 
1608:System/storage/Storage.c ****     return true;
1609:System/storage/Storage.c **** }
