1583:System/storage/Storage.c ****     
1584:System/storage/Storage.c ****     crc_buf += sizeof(item.head_tag);
1585:System/storage/Storage.c ****     crc_len -= sizeof(item.head_tag);
1586:System/storage/Storage.c ****     crc_len -= sizeof(item.end_tag);
1587:System/storage/Storage.c ****     crc_len -= sizeof(item.crc16);
1588:System/storage/Storage.c ****     crc = Common_CRC16(crc_buf, crc_len);
1589:System/storage/Storage.c **** 
1590:System/storage/Storage.c ****     if (crc == item.crc16)
1591:System/storage/Storage.c ****         return true;
1592:System/storage/Storage.c **** 
1593:System/storage/Storage.c ****     return false;
1594:System/storage/Storage.c **** }
