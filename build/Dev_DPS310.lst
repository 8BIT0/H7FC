 303:Device/Dev_DPS310.c **** /* single trigger one shot mode */
 304:Device/Dev_DPS310.c **** static bool DevDPS310_Sample(DevDPS310Obj_TypeDef *obj)
 305:Device/Dev_DPS310.c **** {
 306:Device/Dev_DPS310.c ****     uint8_t bus_read[6] = {0};
 307:Device/Dev_DPS310.c **** 
 308:Device/Dev_DPS310.c ****     if(obj)
 309:Device/Dev_DPS310.c ****     {
 310:Device/Dev_DPS310.c ****         obj->ready = false;
 311:Device/Dev_DPS310.c **** 
 312:Device/Dev_DPS310.c ****         // read pressure data from register
 313:Device/Dev_DPS310.c ****         if(!DevDPS310_ReadLenByteToReg(obj, DPS310_PSR_B2_REG, bus_read, sizeof(bus_read)))
 314:Device/Dev_DPS310.c ****         {
 315:Device/Dev_DPS310.c ****             obj->pressure = 0.0f;
ARM GAS  C:\Users\HUAV\AppData\Local\Temp\ccrbqEPT.s 			page 27


 316:Device/Dev_DPS310.c ****             obj->tempra = 0.0f;
 317:Device/Dev_DPS310.c ****             return false;
 318:Device/Dev_DPS310.c ****         }
 319:Device/Dev_DPS310.c **** 
 320:Device/Dev_DPS310.c ****         obj->none_scale_pressure = 0;
 321:Device/Dev_DPS310.c ****         memcpy(&obj->none_scale_pressure, bus_read, 3);
 322:Device/Dev_DPS310.c **** 
 323:Device/Dev_DPS310.c ****         obj->none_scale_tempra = 0;
 324:Device/Dev_DPS310.c ****         memcpy(&obj->none_scale_tempra, &bus_read[3], 3);
 325:Device/Dev_DPS310.c **** 
 326:Device/Dev_DPS310.c ****         // Calculate scaled measurement results.
 327:Device/Dev_DPS310.c ****         const float Praw_sc = DevDPS310_GetTwoComplementOf((bus_read[0] << 16) + (bus_read[1] << 8)
 328:Device/Dev_DPS310.c ****         const float Traw_sc = DevDPS310_GetTwoComplementOf((bus_read[3] << 16) + (bus_read[4] << 8)
 329:Device/Dev_DPS310.c **** 
 330:Device/Dev_DPS310.c ****         // Calculate compensated measurement results.
 331:Device/Dev_DPS310.c ****         const float c00 = obj->cali_coefs.c00;
 332:Device/Dev_DPS310.c ****         const float c01 = obj->cali_coefs.c01;
 333:Device/Dev_DPS310.c ****         const float c10 = obj->cali_coefs.c10;
 334:Device/Dev_DPS310.c ****         const float c11 = obj->cali_coefs.c11;
 335:Device/Dev_DPS310.c ****         const float c20 = obj->cali_coefs.c20;
 336:Device/Dev_DPS310.c ****         const float c21 = obj->cali_coefs.c21;
 337:Device/Dev_DPS310.c ****         const float c30 = obj->cali_coefs.c30;
 338:Device/Dev_DPS310.c **** 
 339:Device/Dev_DPS310.c ****         // See section 4.9.1, How to Calculate Compensated Pressure Values, of datasheet
 340:Device/Dev_DPS310.c ****         obj->pressure = c00 + Praw_sc * (c10 + Praw_sc * (c20 + Praw_sc * c30)) + Traw_sc * c01 + T
 341:Device/Dev_DPS310.c **** 
 342:Device/Dev_DPS310.c ****         const float c0 = obj->cali_coefs.c0;
 343:Device/Dev_DPS310.c ****         const float c1 = obj->cali_coefs.c1;
 344:Device/Dev_DPS310.c **** 
 345:Device/Dev_DPS310.c ****         // See section 4.9.2, How to Calculate Compensated Temperature Values, of datasheet
 346:Device/Dev_DPS310.c ****         obj->tempra = c0 * 0.5f + c1 * Traw_sc;
 347:Device/Dev_DPS310.c **** 
 348:Device/Dev_DPS310.c ****         obj->cyc ++;
 349:Device/Dev_DPS310.c ****         if(obj->get_tick)
 350:Device/Dev_DPS310.c ****             obj->update_time = obj->get_tick();
 351:Device/Dev_DPS310.c **** 
 352:Device/Dev_DPS310.c ****         obj->ready = true;
 353:Device/Dev_DPS310.c **** 
 354:Device/Dev_DPS310.c ****         return true;
 355:Device/Dev_DPS310.c ****     }
 356:Device/Dev_DPS310.c **** 
 357:Device/Dev_DPS310.c ****     return false;
