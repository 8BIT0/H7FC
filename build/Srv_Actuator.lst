 520:Service/Srv_Actuator.c **** static bool SrvActuator_QuadDrone_MotoMixControl(int16_t *ctl)
 521:Service/Srv_Actuator.c **** {
 522:Service/Srv_Actuator.c ****     float throttle = 0.0f;
 523:Service/Srv_Actuator.c ****     int16_t tmp[4] = {0, 0, 0, 0};
 524:Service/Srv_Actuator.c **** 
 525:Service/Srv_Actuator.c ****     if (!SrvActuator_Obj.init || \
 526:Service/Srv_Actuator.c ****         (ctl == NULL))
 527:Service/Srv_Actuator.c ****         return false;
 528:Service/Srv_Actuator.c **** 
 529:Service/Srv_Actuator.c ****     /* limit throttle max output at 80% */
 530:Service/Srv_Actuator.c ****     if (ctl[Actuator_Ctl_Throttle] >= SRV_ACTUATOR_MAX_THROTTLE_PERCENT)
 531:Service/Srv_Actuator.c ****         ctl[Actuator_Ctl_Throttle] = SRV_ACTUATOR_MAX_THROTTLE_PERCENT;
 532:Service/Srv_Actuator.c **** 
 533:Service/Srv_Actuator.c ****     throttle = ctl[Actuator_Ctl_Throttle] / 100.0f;
 534:Service/Srv_Actuator.c **** 
 535:Service/Srv_Actuator.c ****     for (uint8_t i = 0; i < 4; i++)
 536:Service/Srv_Actuator.c ****     {
 537:Service/Srv_Actuator.c ****         tmp[i] = (SrvActuator_Obj.drive_module.obj_list[i].max_val - \
 538:Service/Srv_Actuator.c ****                   SrvActuator_Obj.drive_module.obj_list[i].idle_val) * \
 539:Service/Srv_Actuator.c ****                   throttle + SrvActuator_Obj.drive_module.obj_list[i].idle_val;
 540:Service/Srv_Actuator.c ****     }
 541:Service/Srv_Actuator.c **** 
 542:Service/Srv_Actuator.c ****     tmp[0] = tmp[0] + ctl[Actuator_Ctl_GyrY] - ctl[Actuator_Ctl_GyrX] - ctl[Actuator_Ctl_GyrZ];
 543:Service/Srv_Actuator.c ****     tmp[1] = tmp[1] + ctl[Actuator_Ctl_GyrY] + ctl[Actuator_Ctl_GyrX] + ctl[Actuator_Ctl_GyrZ];
 544:Service/Srv_Actuator.c ****     tmp[2] = tmp[2] - ctl[Actuator_Ctl_GyrY] + ctl[Actuator_Ctl_GyrX] - ctl[Actuator_Ctl_GyrZ];
 545:Service/Srv_Actuator.c ****     tmp[3] = tmp[3] - ctl[Actuator_Ctl_GyrY] - ctl[Actuator_Ctl_GyrX] + ctl[Actuator_Ctl_GyrZ];
 546:Service/Srv_Actuator.c **** 
 547:Service/Srv_Actuator.c ****     for (uint8_t i = 0; i < 4; i++)
 548:Service/Srv_Actuator.c ****     {
 549:Service/Srv_Actuator.c ****         if (tmp[i] <= SrvActuator_Obj.drive_module.obj_list[i].idle_val)
 550:Service/Srv_Actuator.c ****             tmp[i] = SrvActuator_Obj.drive_module.obj_list[i].idle_val;
ARM GAS  C:\Users\HUAV\AppData\Local\Temp\ccD4cqca.s 			page 22


 551:Service/Srv_Actuator.c **** 
 552:Service/Srv_Actuator.c ****         if (tmp[i] >= SrvActuator_Obj.drive_module.obj_list[i].max_val)
 553:Service/Srv_Actuator.c ****             tmp[i] = SrvActuator_Obj.drive_module.obj_list[i].max_val;
 554:Service/Srv_Actuator.c **** 
 555:Service/Srv_Actuator.c ****         SrvActuator_Moto_DirectDrive(i, tmp[i]);
 556:Service/Srv_Actuator.c ****     }
 557:Service/Srv_Actuator.c **** 
 558:Service/Srv_Actuator.c ****     return true;
 559:Service/Srv_Actuator.c **** }
