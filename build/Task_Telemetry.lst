 124:Task/Task_Telemetry.c **** static void Telemetry_blink(bool arm)
 125:Task/Task_Telemetry.c **** {
 126:Task/Task_Telemetry.c ****     uint32_t Rt = 0;
 127:Task/Task_Telemetry.c ****     static uint32_t Lst_Rt = 0;
 128:Task/Task_Telemetry.c ****     static bool led_state = false;
 129:Task/Task_Telemetry.c ****     DevLedObj_TypeDef LedObj_tmp;
 130:Task/Task_Telemetry.c ****     
 131:Task/Task_Telemetry.c ****     if (Noti_LED_Ptr == NULL)
 132:Task/Task_Telemetry.c ****         return;
 133:Task/Task_Telemetry.c **** 
 134:Task/Task_Telemetry.c ****     memcpy(&LedObj_tmp, Noti_LED_Ptr, sizeof(LedObj_tmp));
 135:Task/Task_Telemetry.c **** 
 136:Task/Task_Telemetry.c ****     /* disarm state */
 137:Task/Task_Telemetry.c ****     if (!arm)
 138:Task/Task_Telemetry.c ****     {
 139:Task/Task_Telemetry.c ****         DevLED.ctl(LedObj_tmp, true);
 140:Task/Task_Telemetry.c ****         return;
 141:Task/Task_Telemetry.c ****     }
 142:Task/Task_Telemetry.c **** 
 143:Task/Task_Telemetry.c ****     Rt = SrvOsCommon.get_os_ms();
 144:Task/Task_Telemetry.c ****     if ((Rt % 50 == 0) && (Lst_Rt != Rt))
 145:Task/Task_Telemetry.c ****     {
ARM GAS  C:\Users\HUAV\AppData\Local\Temp\cc4Ry8sl.s 			page 4


 146:Task/Task_Telemetry.c ****         led_state = !led_state;
 147:Task/Task_Telemetry.c ****         Lst_Rt = Rt;
 148:Task/Task_Telemetry.c ****     }
 149:Task/Task_Telemetry.c **** 
 150:Task/Task_Telemetry.c ****     DevLED.ctl(LedObj_tmp, led_state);
 151:Task/Task_Telemetry.c **** }
