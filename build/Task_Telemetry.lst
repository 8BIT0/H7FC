 153:Task/Task_Telemetry.c **** void TaskTelemetry_Core(void const *arg)
 154:Task/Task_Telemetry.c **** {
 155:Task/Task_Telemetry.c ****     uint32_t pre_time = SrvOsCommon.get_os_ms();
 156:Task/Task_Telemetry.c ****     uint32_t sys_time = 0;
 157:Task/Task_Telemetry.c ****     bool upgrade_state = false;
 158:Task/Task_Telemetry.c ****     Telemetry_RCSig_TypeDef RCSig;
 159:Task/Task_Telemetry.c ****     memset(&RCSig, 0, sizeof(Telemetry_RCSig_TypeDef));
 160:Task/Task_Telemetry.c **** 
 161:Task/Task_Telemetry.c ****     while(1)
 162:Task/Task_Telemetry.c ****     {
 163:Task/Task_Telemetry.c ****         sys_time = SrvOsCommon.get_os_ms();
 164:Task/Task_Telemetry.c **** 
 165:Task/Task_Telemetry.c ****         if (SrvDataHub.get_upgrade_state(&upgrade_state) && !upgrade_state)
 166:Task/Task_Telemetry.c ****         {
 167:Task/Task_Telemetry.c ****             /* RC receiver process */
 168:Task/Task_Telemetry.c ****             RCSig = Telemetry_RC_Sig_Update(&Telemetry_Monitor.RC_Setting, &Receiver_Obj);
 169:Task/Task_Telemetry.c ****             Telemetry_ConvertRCData_To_ControlData(RCSig, DataPipe_DataObjAddr(Rc));
 170:Task/Task_Telemetry.c **** 
 171:Task/Task_Telemetry.c ****             /* triggered when BlackBox Toggle from true -> false */
 172:Task/Task_Telemetry.c ****             if (Telemetry_BlackBox_Toggle_OnRelease(RCSig.blackbox, sys_time, TaskTelemetry_Period)
 173:Task/Task_Telemetry.c ****                 /* trigger blackbox */
 174:Task/Task_Telemetry.c ****                 TaskBlackBox_LogControl();
 175:Task/Task_Telemetry.c **** 
 176:Task/Task_Telemetry.c ****             /* pipe data out */
 177:Task/Task_Telemetry.c ****             DataPipe_SendTo(&Receiver_Smp_DataPipe, &Receiver_hub_DataPipe);
 178:Task/Task_Telemetry.c ****         }
 179:Task/Task_Telemetry.c ****         
 180:Task/Task_Telemetry.c ****         // Telemetry_blink(RCSig.arm_state);
 181:Task/Task_Telemetry.c ****         SrvOsCommon.precise_delay(&pre_time, TaskTelemetry_Period);
 182:Task/Task_Telemetry.c ****     }
 183:Task/Task_Telemetry.c **** }
