 122:Task/Task_Telemetry.c **** static void Telemetry_blink(bool arm)
 123:Task/Task_Telemetry.c **** {
 124:Task/Task_Telemetry.c ****     uint32_t Rt = 0;
 125:Task/Task_Telemetry.c ****     static uint32_t Lst_Rt = 0;
 126:Task/Task_Telemetry.c ****     static bool led_state = false;
 127:Task/Task_Telemetry.c ****     DevLedObj_TypeDef LedObj_tmp;
 128:Task/Task_Telemetry.c ****     
 129:Task/Task_Telemetry.c ****     if (Noti_LED_Ptr == NULL)
 130:Task/Task_Telemetry.c ****         return;
 131:Task/Task_Telemetry.c **** 
 132:Task/Task_Telemetry.c ****     memcpy(&LedObj_tmp, Noti_LED_Ptr, sizeof(LedObj_tmp));
 133:Task/Task_Telemetry.c **** 
 134:Task/Task_Telemetry.c ****     /* disarm state */
 135:Task/Task_Telemetry.c ****     if (!arm)
 136:Task/Task_Telemetry.c ****     {
 137:Task/Task_Telemetry.c ****         DevLED.ctl(LedObj_tmp, true);
 138:Task/Task_Telemetry.c ****         return;
 139:Task/Task_Telemetry.c ****     }
 140:Task/Task_Telemetry.c **** 
 141:Task/Task_Telemetry.c ****     Rt = SrvOsCommon.get_os_ms();
 142:Task/Task_Telemetry.c ****     if ((Rt % 50 == 0) && (Lst_Rt != Rt))
 143:Task/Task_Telemetry.c ****     {
 144:Task/Task_Telemetry.c ****         led_state = !led_state;
ARM GAS  C:\Users\8bit\AppData\Local\Temp\ccIxDeL9.s 			page 4


 145:Task/Task_Telemetry.c ****         Lst_Rt = Rt;
 146:Task/Task_Telemetry.c ****     }
 147:Task/Task_Telemetry.c **** 
 148:Task/Task_Telemetry.c ****     DevLED.ctl(LedObj_tmp, led_state);
 149:Task/Task_Telemetry.c **** }
 150:Task/Task_Telemetry.c **** 
 151:Task/Task_Telemetry.c **** void TaskTelemetry_Core(void const *arg)
 152:Task/Task_Telemetry.c **** {
 153:Task/Task_Telemetry.c ****     uint32_t pre_time = SrvOsCommon.get_os_ms();
 154:Task/Task_Telemetry.c ****     uint32_t sys_time = 0;
 155:Task/Task_Telemetry.c ****     bool upgrade_state = false;
 156:Task/Task_Telemetry.c ****     Telemetry_RCSig_TypeDef RCSig;
 157:Task/Task_Telemetry.c ****     memset(&RCSig, 0, sizeof(Telemetry_RCSig_TypeDef));
 158:Task/Task_Telemetry.c **** 
 159:Task/Task_Telemetry.c ****     while(1)
 160:Task/Task_Telemetry.c ****     {
 161:Task/Task_Telemetry.c ****         sys_time = SrvOsCommon.get_os_ms();
 162:Task/Task_Telemetry.c **** 
 163:Task/Task_Telemetry.c ****         if (SrvDataHub.get_upgrade_state(&upgrade_state) && !upgrade_state)
 164:Task/Task_Telemetry.c ****         {
 165:Task/Task_Telemetry.c ****             /* RC receiver process */
 166:Task/Task_Telemetry.c ****             RCSig = Telemetry_RC_Sig_Update(&Telemetry_Monitor.RC_Setting, &Receiver_Obj);
 167:Task/Task_Telemetry.c ****             Telemetry_ConvertRCData_To_ControlData(RCSig, DataPipe_DataObjAddr(Rc));
 168:Task/Task_Telemetry.c **** 
 169:Task/Task_Telemetry.c ****             /* triggered when BlackBox Toggle from true -> false */
 170:Task/Task_Telemetry.c ****             if (Telemetry_BlackBox_Toggle_OnRelease(RCSig.blackbox, sys_time, TaskTelemetry_Period)
 171:Task/Task_Telemetry.c ****                 /* trigger blackbox */
 172:Task/Task_Telemetry.c ****                 TaskBlackBox_LogControl();
 173:Task/Task_Telemetry.c **** 
 174:Task/Task_Telemetry.c ****             /* pipe data out */
 175:Task/Task_Telemetry.c ****             DataPipe_SendTo(&Receiver_Smp_DataPipe, &Receiver_hub_DataPipe);
 176:Task/Task_Telemetry.c ****         }
 177:Task/Task_Telemetry.c ****         
 178:Task/Task_Telemetry.c ****         // Telemetry_blink(RCSig.arm_state);
 179:Task/Task_Telemetry.c ****         SrvOsCommon.precise_delay(&pre_time, TaskTelemetry_Period);
 180:Task/Task_Telemetry.c ****     }
 181:Task/Task_Telemetry.c **** }
