 359:Task/Task_Telemetry.c **** static Telemetry_ToggleData_TypeDef Telemetry_Toggle_Check(Telemetry_RCFuncMap_TypeDef *toggle)
 360:Task/Task_Telemetry.c **** {
 361:Task/Task_Telemetry.c ****     Telemetry_ToggleData_TypeDef toggle_val;
 362:Task/Task_Telemetry.c ****     uint8_t pos_reg = 0;
 363:Task/Task_Telemetry.c **** 
 364:Task/Task_Telemetry.c ****     toggle_val.pos = 0;
 365:Task/Task_Telemetry.c ****     toggle_val.cnt = 0;
 366:Task/Task_Telemetry.c ****     toggle_val.state = false;
 367:Task/Task_Telemetry.c ****     item_obj *nxt = &toggle->combo_list;
 368:Task/Task_Telemetry.c ****     Telemetry_ChannelSet_TypeDef *channel_data = NULL;
 369:Task/Task_Telemetry.c **** 
 370:Task/Task_Telemetry.c ****     if (!toggle)
 371:Task/Task_Telemetry.c ****         return toggle_val;
 372:Task/Task_Telemetry.c **** 
ARM GAS  C:\Users\8bit\AppData\Local\Temp\ccIxDeL9.s 			page 8


 373:Task/Task_Telemetry.c ****     /* do not use list traverse here */
 374:Task/Task_Telemetry.c ****     while (nxt)
 375:Task/Task_Telemetry.c ****     {
 376:Task/Task_Telemetry.c ****         channel_data = (Telemetry_ChannelSet_TypeDef *)nxt->data;
 377:Task/Task_Telemetry.c **** 
 378:Task/Task_Telemetry.c ****         if (!channel_data ||
 379:Task/Task_Telemetry.c ****             (((*(uint16_t *)channel_data->channel_ptr) <= channel_data->max) &&
 380:Task/Task_Telemetry.c ****              ((*(uint16_t *)channel_data->channel_ptr) >= channel_data->min)))
 381:Task/Task_Telemetry.c ****         {
 382:Task/Task_Telemetry.c ****             pos_reg |= 1 << toggle_val.pos;
 383:Task/Task_Telemetry.c ****             toggle_val.cnt++;
 384:Task/Task_Telemetry.c ****         }
 385:Task/Task_Telemetry.c **** 
 386:Task/Task_Telemetry.c ****         toggle_val.pos++;
 387:Task/Task_Telemetry.c ****         nxt = nxt->nxt;
 388:Task/Task_Telemetry.c ****     }
 389:Task/Task_Telemetry.c **** 
 390:Task/Task_Telemetry.c ****     /* get the number of the bit on set */
 391:Task/Task_Telemetry.c ****     if (Get_OnSet_Bit_Num(pos_reg) == 1)
 392:Task/Task_Telemetry.c ****     {
 393:Task/Task_Telemetry.c ****         /* only on bit been set */
 394:Task/Task_Telemetry.c ****         toggle_val.pos = Get_Bit_Index(pos_reg);
 395:Task/Task_Telemetry.c ****     }
 396:Task/Task_Telemetry.c ****     else
 397:Task/Task_Telemetry.c ****     {
 398:Task/Task_Telemetry.c ****         /* many bits been set on pos_reg */
 399:Task/Task_Telemetry.c ****         toggle_val.pos = 0;
 400:Task/Task_Telemetry.c ****     }
 401:Task/Task_Telemetry.c **** 
 402:Task/Task_Telemetry.c ****     if (toggle_val.cnt == toggle->combo_cnt)
 403:Task/Task_Telemetry.c ****         toggle_val.state = true;
 404:Task/Task_Telemetry.c **** 
 405:Task/Task_Telemetry.c ****     return toggle_val;
 406:Task/Task_Telemetry.c **** }
