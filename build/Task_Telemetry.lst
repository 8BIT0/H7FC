 361:Task/Task_Telemetry.c **** static Telemetry_ToggleData_TypeDef Telemetry_Toggle_Check(Telemetry_RCFuncMap_TypeDef *toggle)
 362:Task/Task_Telemetry.c **** {
 363:Task/Task_Telemetry.c ****     Telemetry_ToggleData_TypeDef toggle_val;
 364:Task/Task_Telemetry.c ****     uint8_t pos_reg = 0;
 365:Task/Task_Telemetry.c **** 
 366:Task/Task_Telemetry.c ****     toggle_val.pos = 0;
 367:Task/Task_Telemetry.c ****     toggle_val.cnt = 0;
 368:Task/Task_Telemetry.c ****     toggle_val.state = false;
 369:Task/Task_Telemetry.c ****     item_obj *nxt = &toggle->combo_list;
 370:Task/Task_Telemetry.c ****     Telemetry_ChannelSet_TypeDef *channel_data = NULL;
 371:Task/Task_Telemetry.c **** 
 372:Task/Task_Telemetry.c ****     if (!toggle)
ARM GAS  C:\Users\HUAV\AppData\Local\Temp\cc2Oadth.s 			page 8


 373:Task/Task_Telemetry.c ****         return toggle_val;
 374:Task/Task_Telemetry.c **** 
 375:Task/Task_Telemetry.c ****     /* do not use list traverse here */
 376:Task/Task_Telemetry.c ****     while (nxt)
 377:Task/Task_Telemetry.c ****     {
 378:Task/Task_Telemetry.c ****         channel_data = (Telemetry_ChannelSet_TypeDef *)nxt->data;
 379:Task/Task_Telemetry.c **** 
 380:Task/Task_Telemetry.c ****         if (!channel_data ||
 381:Task/Task_Telemetry.c ****             (((*(uint16_t *)channel_data->channel_ptr) <= channel_data->max) &&
 382:Task/Task_Telemetry.c ****              ((*(uint16_t *)channel_data->channel_ptr) >= channel_data->min)))
 383:Task/Task_Telemetry.c ****         {
 384:Task/Task_Telemetry.c ****             pos_reg |= 1 << toggle_val.pos;
 385:Task/Task_Telemetry.c ****             toggle_val.cnt++;
 386:Task/Task_Telemetry.c ****         }
 387:Task/Task_Telemetry.c **** 
 388:Task/Task_Telemetry.c ****         toggle_val.pos++;
 389:Task/Task_Telemetry.c ****         nxt = nxt->nxt;
 390:Task/Task_Telemetry.c ****     }
 391:Task/Task_Telemetry.c **** 
 392:Task/Task_Telemetry.c ****     /* get the number of the bit on set */
 393:Task/Task_Telemetry.c ****     if (Get_OnSet_Bit_Num(pos_reg) == 1)
 394:Task/Task_Telemetry.c ****     {
 395:Task/Task_Telemetry.c ****         /* only on bit been set */
 396:Task/Task_Telemetry.c ****         toggle_val.pos = Get_Bit_Index(pos_reg);
 397:Task/Task_Telemetry.c ****     }
 398:Task/Task_Telemetry.c ****     else
 399:Task/Task_Telemetry.c ****     {
 400:Task/Task_Telemetry.c ****         /* many bits been set on pos_reg */
 401:Task/Task_Telemetry.c ****         toggle_val.pos = 0;
 402:Task/Task_Telemetry.c ****     }
 403:Task/Task_Telemetry.c **** 
 404:Task/Task_Telemetry.c ****     if (toggle_val.cnt == toggle->combo_cnt)
 405:Task/Task_Telemetry.c ****         toggle_val.state = true;
 406:Task/Task_Telemetry.c **** 
 407:Task/Task_Telemetry.c ****     return toggle_val;
 408:Task/Task_Telemetry.c **** }
