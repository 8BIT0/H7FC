 275:Algorithm/Filter_Dep/filter.c **** static float SmoothWindow_Update(SW_Object_Handle hdl, float cur_e)
 276:Algorithm/Filter_Dep/filter.c **** {
 277:Algorithm/Filter_Dep/filter.c ****     float sum = 0.0f;
 278:Algorithm/Filter_Dep/filter.c ****     SmoothWindow_Param_TypeDef *param = NULL; 
 279:Algorithm/Filter_Dep/filter.c **** 
 280:Algorithm/Filter_Dep/filter.c ****     if(hdl)
 281:Algorithm/Filter_Dep/filter.c ****     {
 282:Algorithm/Filter_Dep/filter.c ****         param = (SmoothWindow_Param_TypeDef *)hdl;
 283:Algorithm/Filter_Dep/filter.c ****     
 284:Algorithm/Filter_Dep/filter.c ****         if(param->smooth_period < param->window_size)
 285:Algorithm/Filter_Dep/filter.c ****             param->smooth_period ++;
 286:Algorithm/Filter_Dep/filter.c **** 
 287:Algorithm/Filter_Dep/filter.c ****         Filter_Item_Update(&(param->window_header), &(param->window_ender), cur_e);
 288:Algorithm/Filter_Dep/filter.c ****      
 289:Algorithm/Filter_Dep/filter.c ****         List_traverse(param->window_header, SmoothWindow_Comput_Sum, &sum, pre_callback);
 290:Algorithm/Filter_Dep/filter.c ****         sum /= param->smooth_period;
 291:Algorithm/Filter_Dep/filter.c ****     }
 292:Algorithm/Filter_Dep/filter.c **** 
 293:Algorithm/Filter_Dep/filter.c ****     return sum;
 294:Algorithm/Filter_Dep/filter.c **** }
