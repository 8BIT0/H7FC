  42:Algorithm/Filter_Dep/filter.c **** static bool Filter_List_Create(uint8_t order, item_obj *item, list_obj **header, item_obj **ender)
  43:Algorithm/Filter_Dep/filter.c **** {
  44:Algorithm/Filter_Dep/filter.c ****     for (uint8_t i = 0; i < order; i++)
  45:Algorithm/Filter_Dep/filter.c ****     {
  46:Algorithm/Filter_Dep/filter.c ****         float *u_temp = (float *)FILTER_MALLOC(sizeof(float));
  47:Algorithm/Filter_Dep/filter.c **** 
  48:Algorithm/Filter_Dep/filter.c ****         if (u_temp == NULL)
  49:Algorithm/Filter_Dep/filter.c ****         {
  50:Algorithm/Filter_Dep/filter.c ****             FILTER_FREE(u_temp);
  51:Algorithm/Filter_Dep/filter.c ****             return false;
  52:Algorithm/Filter_Dep/filter.c ****         }
  53:Algorithm/Filter_Dep/filter.c ****         else
  54:Algorithm/Filter_Dep/filter.c ****         {
  55:Algorithm/Filter_Dep/filter.c ****             List_ItemInit(&item[i], u_temp);
  56:Algorithm/Filter_Dep/filter.c ****             *u_temp = 0.0f;
  57:Algorithm/Filter_Dep/filter.c ****         }
  58:Algorithm/Filter_Dep/filter.c **** 
  59:Algorithm/Filter_Dep/filter.c ****         /* link element */
  60:Algorithm/Filter_Dep/filter.c ****         if (i > 0)
  61:Algorithm/Filter_Dep/filter.c ****         {
  62:Algorithm/Filter_Dep/filter.c ****             item[i - 1].nxt = &item[i];
  63:Algorithm/Filter_Dep/filter.c ****             item[i].prv = &item[i - 1];
  64:Algorithm/Filter_Dep/filter.c ****         }
  65:Algorithm/Filter_Dep/filter.c ****         else
  66:Algorithm/Filter_Dep/filter.c ****             *header = &item[0];
  67:Algorithm/Filter_Dep/filter.c ****     }
  68:Algorithm/Filter_Dep/filter.c **** 
  69:Algorithm/Filter_Dep/filter.c ****     *ender = &item[order - 1];
  70:Algorithm/Filter_Dep/filter.c **** 
  71:Algorithm/Filter_Dep/filter.c ****     return true;
  72:Algorithm/Filter_Dep/filter.c **** }
