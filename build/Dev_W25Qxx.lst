 404:Device/Dev_W25Qxx.c ****         info.prod_code = dev->prod_code;
 405:Device/Dev_W25Qxx.c **** 
 406:Device/Dev_W25Qxx.c ****         /* currently we only have such type of flash chip on the evk or fc-board */
 407:Device/Dev_W25Qxx.c ****         switch ((uint8_t)(dev->prod_type))
 408:Device/Dev_W25Qxx.c ****         {
 409:Device/Dev_W25Qxx.c ****             case DevW25Q_64:
 410:Device/Dev_W25Qxx.c ****                 info.flash_size  = W25Q64FV_FLASH_SIZE;
 411:Device/Dev_W25Qxx.c ****                 info.page_num    = W25Q64FV_PAGE_NUM;
