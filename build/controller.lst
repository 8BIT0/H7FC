 119:Algorithm/Control_Dep/controller.c **** static bool Controller_Set_Param(bool ARM, ControlTarget_List target, ControlMode_List mode, uint8_
 120:Algorithm/Control_Dep/controller.c **** {
 121:Algorithm/Control_Dep/controller.c ****     /* noticed: only when drone is under ARM state, parameter is setable */
 122:Algorithm/Control_Dep/controller.c ****     /* check drone state */
 123:Algorithm/Control_Dep/controller.c ****     if (!ARM || \
 124:Algorithm/Control_Dep/controller.c ****         (target > CtlT_Altitude) || \
ARM GAS  C:\Users\HUAV\AppData\Local\Temp\ccwyyIwu.s 			page 6


 125:Algorithm/Control_Dep/controller.c ****         (mode >= CtlM_All) || \
 126:Algorithm/Control_Dep/controller.c ****         (p_param == NULL) || \
 127:Algorithm/Control_Dep/controller.c ****         (size == 0))
 128:Algorithm/Control_Dep/controller.c ****         return false;
 129:Algorithm/Control_Dep/controller.c **** 
 130:Algorithm/Control_Dep/controller.c ****     if (target == CtlT_Attitude)
 131:Algorithm/Control_Dep/controller.c ****     {
 132:Algorithm/Control_Dep/controller.c ****         switch (mode)
 133:Algorithm/Control_Dep/controller.c ****         {
 134:Algorithm/Control_Dep/controller.c ****             case CtlM_PID: return Controller_PID_AttParam_Set(p_param, size);
 135:Algorithm/Control_Dep/controller.c ****             default: return false;
 136:Algorithm/Control_Dep/controller.c ****         }
 137:Algorithm/Control_Dep/controller.c ****     }
 138:Algorithm/Control_Dep/controller.c ****     else if (target == CtlT_Altitude)
 139:Algorithm/Control_Dep/controller.c ****     {
 140:Algorithm/Control_Dep/controller.c ****         /* still in developping */
 141:Algorithm/Control_Dep/controller.c ****         switch (mode)
 142:Algorithm/Control_Dep/controller.c ****         {
 143:Algorithm/Control_Dep/controller.c ****             case CtlM_PID: return false;
 144:Algorithm/Control_Dep/controller.c ****             default: return false;
 145:Algorithm/Control_Dep/controller.c ****         }
 146:Algorithm/Control_Dep/controller.c ****     }
 147:Algorithm/Control_Dep/controller.c **** 
 148:Algorithm/Control_Dep/controller.c ****     return false;
 149:Algorithm/Control_Dep/controller.c **** }
