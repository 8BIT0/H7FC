 128:Device/Dev_WS2812.c ****   
 129:Device/Dev_WS2812.c **** void rgb2hsv(uint8_t r, uint8_t g, uint8_t b, float  *h, float  *s, float  *v)
 130:Device/Dev_WS2812.c **** {
 131:Device/Dev_WS2812.c **** 	float  red, green ,blue;
 132:Device/Dev_WS2812.c **** 	float  cmax, cmin, delta;
 133:Device/Dev_WS2812.c **** 	
 134:Device/Dev_WS2812.c **** 	red = (float)r / UINT8_MAX;
 135:Device/Dev_WS2812.c **** 	green = (float)g / UINT8_MAX;
 136:Device/Dev_WS2812.c **** 	blue = (float)b / UINT8_MAX;
 137:Device/Dev_WS2812.c **** 	
 138:Device/Dev_WS2812.c **** 	cmax = find_max(red, green, blue);
 139:Device/Dev_WS2812.c **** 	cmin = find_min(red, green, blue);
 140:Device/Dev_WS2812.c **** 	delta = cmax - cmin;
 141:Device/Dev_WS2812.c **** 	
 142:Device/Dev_WS2812.c **** 	/* H */
 143:Device/Dev_WS2812.c **** 	if (delta == 0)
 144:Device/Dev_WS2812.c **** 	{
 145:Device/Dev_WS2812.c **** 		*h = 0;
 146:Device/Dev_WS2812.c **** 	}
ARM GAS  C:\Users\HUAV\AppData\Local\Temp\ccPflAkp.s 			page 10


 147:Device/Dev_WS2812.c **** 	else
 148:Device/Dev_WS2812.c **** 	{
 149:Device/Dev_WS2812.c **** 		if (cmax == red)
 150:Device/Dev_WS2812.c **** 		{
 151:Device/Dev_WS2812.c ****             *h = 60 * ((green - blue) / delta) + 360;
 152:Device/Dev_WS2812.c **** 			if (green >= blue)
 153:Device/Dev_WS2812.c **** 				*h = 60 * ((green - blue) / delta);
 154:Device/Dev_WS2812.c **** 		}
 155:Device/Dev_WS2812.c **** 		else if (cmax == green)
 156:Device/Dev_WS2812.c **** 		{
 157:Device/Dev_WS2812.c **** 			*h = 60 * ((blue - red) / delta + 2);
 158:Device/Dev_WS2812.c **** 		}
 159:Device/Dev_WS2812.c **** 		else if (cmax == blue)
 160:Device/Dev_WS2812.c **** 		{
 161:Device/Dev_WS2812.c **** 			*h = 60 * ((red - green) / delta + 4);
 162:Device/Dev_WS2812.c **** 		}
 163:Device/Dev_WS2812.c **** 	}
 164:Device/Dev_WS2812.c **** 	
 165:Device/Dev_WS2812.c **** 	/* S */
 166:Device/Dev_WS2812.c ****     *s = delta / cmax;
 167:Device/Dev_WS2812.c **** 	if (cmax == 0)
 168:Device/Dev_WS2812.c **** 		*s = 0;
 169:Device/Dev_WS2812.c **** 	
 170:Device/Dev_WS2812.c **** 	/* V */
 171:Device/Dev_WS2812.c **** 	*v = cmax;
 172:Device/Dev_WS2812.c **** }
