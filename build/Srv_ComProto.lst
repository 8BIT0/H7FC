  17:Service/../MAVLink/common/../mavlink_helpers.h **** MAVLINK_HELPER mavlink_status_t* mavlink_get_channel_status(uint8_t chan)
  18:Service/../MAVLink/common/../mavlink_helpers.h **** {
  19:Service/../MAVLink/common/../mavlink_helpers.h **** #ifdef MAVLINK_EXTERNAL_RX_STATUS
  20:Service/../MAVLink/common/../mavlink_helpers.h **** 	// No m_mavlink_status array defined in function,
  21:Service/../MAVLink/common/../mavlink_helpers.h **** 	// has to be defined externally
  22:Service/../MAVLink/common/../mavlink_helpers.h **** #else
  23:Service/../MAVLink/common/../mavlink_helpers.h **** 	static mavlink_status_t m_mavlink_status[MAVLINK_COMM_NUM_BUFFERS];
  24:Service/../MAVLink/common/../mavlink_helpers.h **** #endif
