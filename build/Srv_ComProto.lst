 135:Service/Srv_ComProto.c **** static void SrvComProto_MsgToStream(SrvComProto_MsgInfo_TypeDef *msg, SrvComProto_Stream_TypeDef *c
 136:Service/Srv_ComProto.c **** {
 137:Service/Srv_ComProto.c ****     uint32_t sys_time = SrvOsCommon.get_os_ms();
 138:Service/Srv_ComProto.c **** 
 139:Service/Srv_ComProto.c ****     if (msg->enable && com_stream && com_stream->p_buf && msg->pack_callback)
 140:Service/Srv_ComProto.c ****     {
 141:Service/Srv_ComProto.c ****         msg->in_proto = true;
 142:Service/Srv_ComProto.c **** 
 143:Service/Srv_ComProto.c ****         if ((msg->proto_time) && (sys_time - msg->proto_time < msg->period))
 144:Service/Srv_ComProto.c ****         {
 145:Service/Srv_ComProto.c ****             msg->in_proto = false;
 146:Service/Srv_ComProto.c ****             return;
 147:Service/Srv_ComProto.c ****         }
 148:Service/Srv_ComProto.c **** 
 149:Service/Srv_ComProto.c ****         com_stream->size = msg->pack_callback((uint8_t *)msg);
 150:Service/Srv_ComProto.c **** 
 151:Service/Srv_ComProto.c ****         if (com_stream->size && ((com_stream->size + MAVLINK_NUM_NON_PAYLOAD_BYTES) <= com_stream->
 152:Service/Srv_ComProto.c ****         {
 153:Service/Srv_ComProto.c ****             com_stream->size = mavlink_msg_to_send_buffer(com_stream->p_buf, msg->msg_obj);
 154:Service/Srv_ComProto.c **** 
 155:Service/Srv_ComProto.c ****             if (tx_cb)
 156:Service/Srv_ComProto.c ****             {
 157:Service/Srv_ComProto.c ****                 tx_cb(arg, com_stream->p_buf, com_stream->size);
 158:Service/Srv_ComProto.c ****                 msg->proto_cnt ++;
 159:Service/Srv_ComProto.c ****                 memset(com_stream->p_buf, 0, com_stream->size);
 160:Service/Srv_ComProto.c ****             }
 161:Service/Srv_ComProto.c **** 
 162:Service/Srv_ComProto.c ****             msg->proto_time = sys_time;
 163:Service/Srv_ComProto.c ****         }
 164:Service/Srv_ComProto.c **** 
 165:Service/Srv_ComProto.c ****         msg->in_proto = false;
 166:Service/Srv_ComProto.c ****     }
 167:Service/Srv_ComProto.c **** }
