 134:Service/Srv_ComProto.c **** static void SrvComProto_MsgToStream(SrvComProto_MsgInfo_TypeDef *msg, SrvComProto_Stream_TypeDef *c
 135:Service/Srv_ComProto.c **** {
 136:Service/Srv_ComProto.c ****     uint32_t sys_time = SrvOsCommon.get_os_ms();
 137:Service/Srv_ComProto.c **** 
 138:Service/Srv_ComProto.c ****     if (msg->enable && com_stream && com_stream->p_buf && msg->pack_callback)
 139:Service/Srv_ComProto.c ****     {
 140:Service/Srv_ComProto.c ****         msg->in_proto = true;
 141:Service/Srv_ComProto.c **** 
 142:Service/Srv_ComProto.c ****         if ((msg->proto_time) && (sys_time - msg->proto_time < msg->period))
 143:Service/Srv_ComProto.c ****         {
 144:Service/Srv_ComProto.c ****             msg->in_proto = false;
 145:Service/Srv_ComProto.c ****             return;
 146:Service/Srv_ComProto.c ****         }
 147:Service/Srv_ComProto.c **** 
 148:Service/Srv_ComProto.c ****         com_stream->size = msg->pack_callback((uint8_t *)msg);
 149:Service/Srv_ComProto.c **** 
 150:Service/Srv_ComProto.c ****         if (com_stream->size && ((com_stream->size + MAVLINK_NUM_NON_PAYLOAD_BYTES) <= com_stream->
 151:Service/Srv_ComProto.c ****         {
 152:Service/Srv_ComProto.c ****             com_stream->size = mavlink_msg_to_send_buffer(com_stream->p_buf, msg->msg_obj);
 153:Service/Srv_ComProto.c **** 
 154:Service/Srv_ComProto.c ****             if (tx_cb)
 155:Service/Srv_ComProto.c ****             {
 156:Service/Srv_ComProto.c ****                 tx_cb(arg, com_stream->p_buf, com_stream->size);
 157:Service/Srv_ComProto.c ****                 msg->proto_cnt ++;
 158:Service/Srv_ComProto.c ****                 memset(com_stream->p_buf, 0, com_stream->size);
 159:Service/Srv_ComProto.c ****             }
 160:Service/Srv_ComProto.c **** 
 161:Service/Srv_ComProto.c ****             msg->proto_time = sys_time;
 162:Service/Srv_ComProto.c ****         }
 163:Service/Srv_ComProto.c **** 
 164:Service/Srv_ComProto.c ****         msg->in_proto = false;
 165:Service/Srv_ComProto.c ****     }
 166:Service/Srv_ComProto.c **** }
