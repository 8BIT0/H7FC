 156:Device/Dev_W25Nxx.c ****     dev->write_en = false;
 157:Device/Dev_W25Nxx.c **** 
 158:Device/Dev_W25Nxx.c ****     /* check read status */
 159:Device/Dev_W25Nxx.c ****     err = DevW25Nxx_Check_Read_Status(dev);
 160:Device/Dev_W25Nxx.c ****     if (err == DevW25Nxx_Error)
 161:Device/Dev_W25Nxx.c ****         return DevW25Nxx_Error;
 162:Device/Dev_W25Nxx.c ****     
