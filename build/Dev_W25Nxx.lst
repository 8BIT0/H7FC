 170:Device/Dev_W25Nxx.c ****         err = DevW25Nxx_Check_Read_Status(dev);
 171:Device/Dev_W25Nxx.c ****         if (err == DevW25Nxx_Error)
 172:Device/Dev_W25Nxx.c ****             return DevW25Nxx_Error;
 173:Device/Dev_W25Nxx.c ****     }
 174:Device/Dev_W25Nxx.c **** 
 175:Device/Dev_W25Nxx.c ****     /* get product id */
 176:Device/Dev_W25Nxx.c ****     dev->prod_type = DevW25Nxx_Get_ProductID(dev);
 177:Device/Dev_W25Nxx.c ****     if (dev->prod_type == DevW25N_None)
 178:Device/Dev_W25Nxx.c ****         return DevW25Nxx_Error;
 179:Device/Dev_W25Nxx.c **** 
