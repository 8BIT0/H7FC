 145:Device/Dev_W25Nxx.c **** static DevW25Nxx_Error_List DevW25Nxx_Init(DevW25NxxObj_TypeDef *dev)
 146:Device/Dev_W25Nxx.c **** {
 147:Device/Dev_W25Nxx.c ****     DevW25Nxx_Error_List err = DevW25Nxx_Ok;
 148:Device/Dev_W25Nxx.c ****     uint32_t sys_time = 0;
 149:Device/Dev_W25Nxx.c **** 
 150:Device/Dev_W25Nxx.c ****     if ((dev == NULL) || \
