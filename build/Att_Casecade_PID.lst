 217:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c **** static bool Att_Casecade_PID(uint32_t sys_ms, bool angular_only, AttControl_In_TypeDef exp, AttCont
 218:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c **** {
 219:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****     float dynamic_tune_rate = 1.0f;
