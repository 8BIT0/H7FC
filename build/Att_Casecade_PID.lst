 223:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****         return false;
 224:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c **** 
 225:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****     if (!angular_only)
 226:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****     {
 227:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****         /* attitude loop */
 228:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****         /* dynamic trim is unavilable in this loop */
 229:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****         /* Pitch PID update */
 230:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****         PID_Update(&ProcessPara.pitch, sys_ms, mea.pitch, exp.pitch);
 231:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****         exp.gyro_y = ProcessPara.pitch.fout;
 232:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c **** 
 233:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****         /* Roll PID update */
 234:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****         PID_Update(&ProcessPara.roll, sys_ms, mea.roll, exp.roll);
 235:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****         exp.gyro_x = ProcessPara.roll.fout;
 236:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****     }
 237:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****     else
 238:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****     {
 239:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****         ProcessPara.pitch.lst_diff = 0.0f;
 240:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c ****         ProcessPara.pitch.Integral = 0.0f;
 241:Algorithm/Control_Dep/Attitude/Att_Casecade_PID.c **** 
