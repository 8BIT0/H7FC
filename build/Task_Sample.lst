 115:Task/Task_Sample.c **** void TaskSample_Core(void const *arg)
 116:Task/Task_Sample.c **** {
 117:Task/Task_Sample.c ****     uint32_t sys_time = SrvOsCommon.get_os_ms();
 118:Task/Task_Sample.c ****     
 119:Task/Task_Sample.c ****     while(1)
 120:Task/Task_Sample.c ****     {
 121:Task/Task_Sample.c ****         TaskInertical_Blink_Notification(100);
 122:Task/Task_Sample.c **** 
 123:Task/Task_Sample.c ****         if(sample_enable && SrvSensorMonitor.sample_ctl(&SensorMonitor))
 124:Task/Task_Sample.c ****         {
 125:Task/Task_Sample.c ****             DataPipe_DataObj(IMU_Data) = SrvSensorMonitor.get_imu_data(&SensorMonitor);
 126:Task/Task_Sample.c ****             DataPipe_DataObj(Baro_Data) = SrvSensorMonitor.get_baro_data(&SensorMonitor);
 127:Task/Task_Sample.c **** 
 128:Task/Task_Sample.c ****             /* need measurement the overhead from pipe send to pipe receive callback triggered */
 129:Task/Task_Sample.c ****             // DebugPin.ctl(Debug_PB4, true);
 130:Task/Task_Sample.c ****             /* to Log task */
 131:Task/Task_Sample.c ****             DataPipe_SendTo(&IMU_Smp_DataPipe, &IMU_Log_DataPipe);
 132:Task/Task_Sample.c ****             DataPipe_SendTo(&Baro_smp_DataPipe, &Baro_Log_DataPipe);
 133:Task/Task_Sample.c **** 
 134:Task/Task_Sample.c ****             /* to data hub */
 135:Task/Task_Sample.c ****             DataPipe_SendTo(&IMU_Smp_DataPipe, &IMU_hub_DataPipe);
 136:Task/Task_Sample.c ****             DataPipe_SendTo(&Baro_smp_DataPipe, &Baro_hub_DataPipe);
 137:Task/Task_Sample.c ****             // DebugPin.ctl(Debug_PB4, false);
 138:Task/Task_Sample.c ****         }
 139:Task/Task_Sample.c ****         
 140:Task/Task_Sample.c ****         SrvOsCommon.precise_delay(&sys_time, TaskSample_Period);
 141:Task/Task_Sample.c ****     }
 142:Task/Task_Sample.c **** }
