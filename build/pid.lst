  49:Algorithm/Control_Dep/pid.c **** bool PID_Update(PIDObj_TypeDef *p_PIDObj, uint32_t sys_ms, const float mea_in, const float exp_in)
  50:Algorithm/Control_Dep/pid.c **** {
  51:Algorithm/Control_Dep/pid.c ****     float diff = exp_in - mea_in;
  52:Algorithm/Control_Dep/pid.c ****     float out_tmp = 0.0f;
  53:Algorithm/Control_Dep/pid.c **** 
  54:Algorithm/Control_Dep/pid.c ****     if (p_PIDObj == NULL)
  55:Algorithm/Control_Dep/pid.c ****         return false;
  56:Algorithm/Control_Dep/pid.c ****     
  57:Algorithm/Control_Dep/pid.c ****     p_PIDObj->in = mea_in;
  58:Algorithm/Control_Dep/pid.c ****     p_PIDObj->exp = exp_in;
  59:Algorithm/Control_Dep/pid.c **** 
  60:Algorithm/Control_Dep/pid.c ****     /* feed foward is essential? */
  61:Algorithm/Control_Dep/pid.c **** 
  62:Algorithm/Control_Dep/pid.c ****     /* if P stage error then PID can`t be use in other progress */
  63:Algorithm/Control_Dep/pid.c ****     if (!PID_P_Progress(p_PIDObj, diff))
  64:Algorithm/Control_Dep/pid.c ****         return false;
  65:Algorithm/Control_Dep/pid.c **** 
  66:Algorithm/Control_Dep/pid.c ****     out_tmp += p_PIDObj->P_out;
  67:Algorithm/Control_Dep/pid.c ****     if(PID_I_Progress(p_PIDObj, diff))
  68:Algorithm/Control_Dep/pid.c ****         out_tmp += p_PIDObj->I_out;
  69:Algorithm/Control_Dep/pid.c **** 
  70:Algorithm/Control_Dep/pid.c ****     if(PID_D_Progress(p_PIDObj, sys_ms, diff))
  71:Algorithm/Control_Dep/pid.c ****         out_tmp += p_PIDObj->D_out;
  72:Algorithm/Control_Dep/pid.c **** 
  73:Algorithm/Control_Dep/pid.c ****     p_PIDObj->fout = out_tmp;
  74:Algorithm/Control_Dep/pid.c ****     return true;
  75:Algorithm/Control_Dep/pid.c **** }
