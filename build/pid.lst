  31:Algorithm/Control_Dep/pid.c **** 
  32:Algorithm/Control_Dep/pid.c **** bool PID_Update(PIDObj_TypeDef *p_PIDObj, uint32_t sys_ms, const float mea_in, const float exp_in)
  33:Algorithm/Control_Dep/pid.c **** {
  34:Algorithm/Control_Dep/pid.c ****     float diff = mea_in - exp_in;
  35:Algorithm/Control_Dep/pid.c ****     float out_tmp = 0.0f;
  36:Algorithm/Control_Dep/pid.c **** 
  37:Algorithm/Control_Dep/pid.c ****     if (p_PIDObj == NULL)
  38:Algorithm/Control_Dep/pid.c ****         return false;
  39:Algorithm/Control_Dep/pid.c ****     
  40:Algorithm/Control_Dep/pid.c ****     p_PIDObj->in = mea_in;
  41:Algorithm/Control_Dep/pid.c ****     p_PIDObj->exp = exp_in;
  42:Algorithm/Control_Dep/pid.c **** 
  43:Algorithm/Control_Dep/pid.c ****     /* feed foward is essential? */
  44:Algorithm/Control_Dep/pid.c **** 
  45:Algorithm/Control_Dep/pid.c ****     /* if P stage error then PID can`t be use in other progress */
  46:Algorithm/Control_Dep/pid.c ****     if (!PID_P_Progress(p_PIDObj, diff))
  47:Algorithm/Control_Dep/pid.c ****         return false;
  48:Algorithm/Control_Dep/pid.c **** 
  49:Algorithm/Control_Dep/pid.c ****     out_tmp += p_PIDObj->P_out;
  50:Algorithm/Control_Dep/pid.c ****     if(PID_I_Progress(p_PIDObj, diff))
  51:Algorithm/Control_Dep/pid.c ****         out_tmp += p_PIDObj->I_out;
  52:Algorithm/Control_Dep/pid.c **** 
  53:Algorithm/Control_Dep/pid.c ****     if(PID_D_Progress(p_PIDObj, sys_ms, diff))
  54:Algorithm/Control_Dep/pid.c ****         out_tmp += p_PIDObj->D_out;
  55:Algorithm/Control_Dep/pid.c **** 
  56:Algorithm/Control_Dep/pid.c ****     p_PIDObj->fout = out_tmp;
  57:Algorithm/Control_Dep/pid.c ****     return true;
  58:Algorithm/Control_Dep/pid.c **** }
