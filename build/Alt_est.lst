  69:Eigen/src/Core/CwiseNullaryOp.h ****       : m_rows(rows), m_cols(cols), m_functor(func)
  70:Eigen/src/Core/CwiseNullaryOp.h ****     {
  71:Eigen/src/Core/CwiseNullaryOp.h ****       eigen_assert(rows >= 0
